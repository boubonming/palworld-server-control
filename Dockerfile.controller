FROM python:3.12-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PALWORLD_CONTROL_DATA_DIR=/data

WORKDIR /app
COPY requirements-common.txt requirements-controller.txt ./
RUN pip install --no-cache-dir --no-compile -r requirements-controller.txt
COPY src/controller ./src/controller
COPY src/core ./src/core
COPY src/integrations ./src/integrations
COPY src/shared ./src/shared
COPY src/server_main.py ./src/server_main.py
COPY metadata.json technology_ids.json ./

RUN mkdir -p /data

VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3).read()"]
CMD ["python", "src/server_main.py", "--host", "0.0.0.0", "--port", "8080"]
