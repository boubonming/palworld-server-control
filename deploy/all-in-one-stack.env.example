PALWORLD_CONTROL_WEB_PASSWORD=replace-with-at-least-10-characters
PALWORLD_ADMIN_PASSWORD=replace-with-a-secure-admin-password
PALWORLD_SERVER_PASSWORD=

# Set true to list the server in Palworld's community browser.
PALWORLD_COMMUNITY=false

# For a new server, leave this false for the first start, then set it to true and
# redeploy before editing settings through Palworld Server Control.
PALWORLD_DISABLE_GENERATE_SETTINGS=false

PALWORLD_SERVER_NAME=Palworld Server
PALWORLD_SERVER_DESCRIPTION=Managed by Palworld Server Control
PALWORLD_PLAYERS=16
PALWORLD_PORT=8211
PALWORLD_QUERY_PORT=27015
PALWORLD_REST_API_PORT=8212

CONTROLLER_WEB_PORT=8080
TZ=UTC
PUID=1000
PGID=1000

CONTROLLER_IMAGE_TAG=latest
PALWORLD_IMAGE_TAG=latest
PALWORLD_DATA_DIR=./palworld
